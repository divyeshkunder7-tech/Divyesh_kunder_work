#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="HELLO";
    int len=strlen(str);
    printf("\n%s",str);
    for(int i=0;i<len-1;i++)
    {
        for(int j=0;j<len-i-1;j++)
        {
            if(str[j]>str[j+1])
            {
                char ch=str[j];
                str[j]=str[j+1];
                str[j+1]=ch;
            }
        }
        printf("\n%s",str);
    }
    return 0;
}
