#include<stdio.h>
int main()
{
    int a;
    printf("\nEnter a number:");
    scanf("%d",&a);
    if(a>=1&&a<=10)
    {
        printf("\nNumber is in the range of 1 to 10");
    }
    else if(a>=11&&a<=20)
    {
        printf("\nNumber is in the range of 11 to 20");
    }
    else
    {
        printf("\nNumber is above 20");
    }
    return 0;
}
