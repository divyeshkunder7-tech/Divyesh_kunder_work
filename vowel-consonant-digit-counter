#include<stdio.h>
#include<string.h>
#include<ctype.h>
int main()
{
    char str[100];
    int digi=0,vow=0,cons=0;
    int i;
    printf("\n Enter your keybind:");
    fgets(str,sizeof(str),stdin);
    for(i=0;str[i]!='\0'&&str[i]!='\n';i++)
    {
        char ch=str[i];
        if(isdigit(ch))
        {
            digi++;
        }
    
        else if(isalpha(ch))
        {
          ch=tolower(ch);
          if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u')
          {
            vow++;
          }
          else
          {
            cons++;
          }

        }
    }
    printf("\n%d",digi);
    printf("\n%d",vow);
    printf("\n%d",cons);
    return 0;
    
}
